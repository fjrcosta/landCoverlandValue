   "source": [
    "import osmnx as ox\n",
    "import networkx as nx\n",
    "import geopandas as gpd\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from shapely.geometry import Point, Polygon, LineString\n",
    "from shapely.ops import unary_union\n",
    "from scipy.spatial import ConvexHull\n",
    "from pyproj import Transformer\n",
    "import folium\n",
    "import matplotlib.colors as mcolors\n",
    "import warnings\n",
    "from shapely.geometry import MultiPoint\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "ox.settings.use_cache = False\n",
    "\n",
    "# ===== PALETAS E CORES =====\n",
    "\n",
    "class_colors = {\n",
    "    'bare': '#bf8040',\n",
    "    'bush': '#009900',\n",
    "    'crop': '#ffdf99',\n",
    "    'grass': '#33ff33',\n",
    "    'hduf': '#69000d',\n",
    "    'industrial': '#e93529',\n",
    "    'lduf': '#c7171c',\n",
    "    'mduf': '#a10e15',\n",
    "    'tree': '#003300',\n",
    "    'water': '#0b9fd5'\n",
    "}\n",
    "\n",
    "class_labels = {\n",
    "    \"hduf\": \"High Density Urban\",\n",
    "    \"mduf\": \"Medium Density Urban\",\n",
    "    \"lduf\": \"Low Density Urban\",\n",
    "    \"industrial\": \"Industrial Areas\",\n",
    "    \"bare\": \"Bare Soil\",\n",
    "    \"grass\": \"Grass/Pasture\",\n",
    "    \"bush\": \"Shrub/Scrubs\",\n",
    "    \"tree\": \"Perennial Trees\",\n",
    "    \"water\": \"Perennial Water\",\n",
    "    \"crop\": \"Row Crops\"\n",
    "}\n",
    "\n",
    "def tim_colors(n=1000):\n",
    "    colors = [\n",
    "        '#000080', '#0000CC', '#0040FF', '#0080FF', '#00BFFF', '#00FFFF',\n",
    "        '#00FFBF', '#00FF80', '#00FF40', '#00FF00', '#40FF00', '#80FF00',\n",
    "        '#BFFF00', '#FFFF00', '#FFBF00', '#FF8000', '#FF4000', '#FF0000'\n",
    "    ]\n",
    "    cmap = mcolors.LinearSegmentedColormap.from_list(\"tim\", colors, N=n)\n",
    "    return [mcolors.rgb2hex(cmap(i)) for i in np.linspace(0, 1, n)]\n",
    "\n",
    "# ===== CLASSES DE TRANSPORTE =====\n",
    "\n",
    "class TransportMode:\n",
    "    def __init__(self, name: str, highway_types: list, speed_kmh: float,\n",
    "                 initial_walk_min: float = 0, waiting_time_min: float = 0,\n",
    "                 final_walk_min: float = 0, color: str = 'blue'):\n",
    "        self.name = name\n",
    "        self.highway_types = highway_types\n",
    "        self.speed_kmh = speed_kmh\n",
    "        self.initial_walk_min = initial_walk_min\n",
    "        self.waiting_time_min = waiting_time_min\n",
    "        self.final_walk_min = final_walk_min\n",
    "        self.color = color\n",
    "        self.overhead_time_min = initial_walk_min + waiting_time_min + final_walk_min\n",
    "        self.speed_ms = speed_kmh / 3.6\n",
    "        # Distância que pode caminhar no final (em metros)\n",
    "        self.final_walk_distance_m = final_walk_min * 60 * (5.0 / 3.6)  # 5 km/h para caminhada\n",
    "    \n",
    "    def get_available_time_seconds(self, total_budget_min: float = 60) -> float:\n",
    "        return (total_budget_min - self.overhead_time_min) * 60\n",
    "\n",
    "def define_transport_modes() -> dict:\n",
    "    modes = {\n",
    "        'walking': TransportMode(\n",
    "            name='walking',\n",
    "            highway_types=['motorway', 'trunk', 'primary', 'secondary', 'tertiary', \n",
    "                          'residential', 'unclassified', 'living_street'],\n",
    "            speed_kmh=5.0,\n",
    "            initial_walk_min=0,\n",
    "            waiting_time_min=0,\n",
    "            final_walk_min=0,\n",
    "            color='#2ecc71'\n",
    "        ),\n",
    "        'cycling': TransportMode(\n",
    "            name='cycling',\n",
    "            highway_types=['motorway', 'trunk', 'primary', 'secondary', 'tertiary',\n",
    "                          'residential', 'unclassified', 'living_street'],\n",
    "            speed_kmh=16.0,\n",
    "            initial_walk_min=2,\n",
    "            waiting_time_min=0,\n",
    "            final_walk_min=2,\n",
    "            color='#3498db'\n",
    "        ),\n",
    "        'bus': TransportMode(\n",
    "            name='bus',\n",
    "            highway_types=['primary', 'secondary', 'tertiary', 'trunk', 'motorway'],\n",
    "            speed_kmh=20.0,\n",
    "            initial_walk_min=5,\n",
    "            waiting_time_min=10,\n",
    "            final_walk_min=5,\n",
    "            color='#e74c3c'\n",
    "        ),\n",
    "        'car': TransportMode(\n",
    "            name='car',\n",
    "            highway_types=['motorway', 'trunk', 'primary', 'secondary', 'tertiary',\n",
    "                          'residential', 'unclassified'],\n",
    "            speed_kmh=35.0,\n",
    "            initial_walk_min=2,\n",
    "            waiting_time_min=0,\n",
    "            final_walk_min=2,\n",
    "            color='#9b59b6'\n",
    "        )\n",
    "    }\n",
    "    return modes\n",
    "\n",
    "# ===== FUNÇÕES AUXILIARES =====\n",
    "\n",
    "def parse_coordinates(coord_str):\n",
    "    lat, lon = map(float, coord_str.split(','))\n",
    "    return lat, lon\n",
    "\n",
    "def create_patch_polygon(row):\n",
    "    tl_lat, tl_lon = parse_coordinates(row['top_left'])\n",
    "    tr_lat, tr_lon = parse_coordinates(row['top_right'])\n",
    "    bl_lat, bl_lon = parse_coordinates(row['bottom_left'])\n",
    "    br_lat, br_lon = parse_coordinates(row['bottom_right'])\n",
    "    \n",
    "    return [\n",
    "        [tl_lat, tl_lon],\n",
    "        [tr_lat, tr_lon],\n",
    "        [br_lat, br_lon],\n",
    "        [bl_lat, bl_lon],\n",
    "        [tl_lat, tl_lon]\n",
    "    ]\n",
    "\n",
    "def get_filtered_network(G: nx.MultiDiGraph, mode: TransportMode) -> nx.MultiDiGraph:\n",
    "    G_filtered = G.copy()\n",
    "    edges_to_remove = []\n",
    "    \n",
    "    for u, v, key, data in G_filtered.edges(keys=True, data=True):\n",
    "        highway = data.get('highway', [])\n",
    "        if isinstance(highway, str):\n",
    "            highway = [highway]\n",
    "        elif not isinstance(highway, list):\n",
    "            highway = []\n",
    "        \n",
    "        if not any(hw in mode.highway_types for hw in highway):\n",
    "            edges_to_remove.append((u, v, key))\n",
    "    \n",
    "    G_filtered.remove_edges_from(edges_to_remove)\n",
    "    \n",
    "    if len(G_filtered) > 0:\n",
    "        largest_cc = max(nx.weakly_connected_components(G_filtered), key=len)\n",
    "        G_filtered = G_filtered.subgraph(largest_cc).copy()\n",
    "    \n",
    "    return G_filtered\n",
    "\n",
    "def calculate_isochrone(G: nx.MultiDiGraph, origin_node: int, mode: TransportMode,\n",
    "                        total_budget_min: float = 60) -> dict:\n",
    "    available_time_sec = mode.get_available_time_seconds(total_budget_min)\n",
    "    max_distance_m = mode.speed_ms * available_time_sec\n",
    "    \n",
    "    reachable_nodes = {}\n",
    "    try:\n",
    "        lengths = nx.single_source_dijkstra_path_length(\n",
    "            G, origin_node, cutoff=max_distance_m, weight='length'\n",
    "        )\n",
    "        reachable_nodes = dict(lengths)\n",
    "    except (nx.NetworkXError, KeyError):\n",
    "        reachable_nodes = {origin_node: 0}\n",
    "    \n",
    "    return reachable_nodes\n",
    "\n",
    "def create_isochrone_polygon_with_final_walk(G: nx.MultiDiGraph, reachable_nodes: dict,\n",
    "                                              coords_map: dict, mode: TransportMode,\n",
    "                                              base_buffer_meters: float = 50) -> Polygon:\n",
    "    \"\"\"\n",
    "    Cria polígono de isócrona baseado na rede viária real.\n",
    "    Inclui buffer adicional para representar a caminhada final.\n",
    "    \"\"\"\n",
    "    if not reachable_nodes:\n",
    "        return None\n",
    "    \n",
    "    # Coletar todas as arestas que conectam nós alcançáveis\n",
    "    reachable_set = set(reachable_nodes.keys())\n",
    "    edge_lines = []\n",
    "    \n",
    "    for u, v, data in G.edges(data=True):\n",
    "        if u in reachable_set and v in reachable_set:\n",
    "            if u in coords_map and v in coords_map:\n",
    "                lon1, lat1 = coords_map[u]\n",
    "                lon2, lat2 = coords_map[v]\n",
    "                edge_lines.append(LineString([(lon1, lat1), (lon2, lat2)]))\n",
    "    \n",
    "    if not edge_lines:\n",
    "        coords = []\n",
    "        for node in reachable_nodes.keys():\n",
    "            if node in coords_map:\n",
    "                lon, lat = coords_map[node]\n",
    "                coords.append(Point(lon, lat))\n",
    "        if coords:\n",
    "            return unary_union(coords).buffer(0.001)\n",
    "        return None\n",
    "    \n",
    "    # Unir todas as linhas\n",
    "    network_union = unary_union(edge_lines)\n",
    "    \n",
    "    # Buffer total = buffer base + distância de caminhada final\n",
    "    total_buffer_meters = base_buffer_meters + mode.final_walk_distance_m\n",
    "    \n",
    "    # Converter buffer de metros para graus\n",
    "    buffer_degrees = total_buffer_meters / 111000\n",
    "    \n",
    "    # Fazer buffer da rede\n",
    "    polygon = network_union.buffer(buffer_degrees)\n",
    "    \n",
    "    # Simplificar para reduzir complexidade\n",
    "    polygon = polygon.simplify(buffer_degrees * 0.5, preserve_topology=True)\n",
    "    \n",
    "    return polygon\n",
    "\n",
    "def get_reachable_edges_gdf(G: nx.MultiDiGraph, reachable_nodes: dict, coords_map: dict) -> gpd.GeoDataFrame:\n",
    "    \"\"\"\n",
    "    Retorna um GeoDataFrame com as arestas alcançáveis.\n",
    "    \"\"\"\n",
    "    reachable_set = set(reachable_nodes.keys())\n",
    "    edges_data = []\n",
    "    \n",
    "    for u, v, data in G.edges(data=True):\n",
    "        if u in reachable_set and v in reachable_set:\n",
    "            if u in coords_map and v in coords_map:\n",
    "                lon1, lat1 = coords_map[u]\n",
    "                lon2, lat2 = coords_map[v]\n",
    "                line = LineString([(lon1, lat1), (lon2, lat2)])\n",
    "                edges_data.append({\n",
    "                    'geometry': line,\n",
    "                    'highway': data.get('highway', 'unknown'),\n",
    "                    'length': data.get('length', 0)\n",
    "                })\n",
    "    \n",
    "    if edges_data:\n",
    "        return gpd.GeoDataFrame(edges_data, crs='EPSG:4326')\n",
    "    return None\n",
    "\n",
    "\n",
    "# ===== FUNÇÃO PRINCIPAL =====\n",
    "\n",
    "def generate_isochrone_map_complete(city_name: str = \"Londrina\",\n",
    "                                    center_lat: float = -23.3120433,\n",
    "                                    center_lon: float = -51.1620788,\n",
    "                                    total_budget_min: float = 60,\n",
    "                                    base_buffer_meters: float = 50) -> folium.Map:\n",
    "    \n",
    "    print(f\"\\n{'='*70}\")\n",
    "    print(f\"Multimodal Urban Commute Reachability Analysis\")\n",
    "    print(f\"City: {city_name}\")\n",
    "    print(f\"{'='*70}\\n\")\n",
    "    \n",
    "    center_point = Point(center_lon, center_lat)\n",
    "    \n",
    "    # 1. Load urban perimeter\n",
    "    print(f\"[1/7] Loading urban perimeter...\")\n",
    "    perimetro_path = \"/Volumes/ssd_externo/UEL DOUTORADO 2022/Artigo GEO/json dados/shapeFiles/shpLondrina/perimetro.GeoJSON\"\n",
    "    \n",
    "    try:\n",
    "        perimetro = gpd.read_file(perimetro_path)\n",
    "        perimetro = perimetro.to_crs('EPSG:4326')\n",
    "        print(f\"  ✓ Perimeter loaded\")\n",
    "    except:\n",
    "        print(f\"  ✗ Perimeter not found → using buffer\")\n",
    "        perimetro = gpd.GeoDataFrame(\n",
    "            {'geometry': [center_point.buffer(0.05)]},\n",
    "            crs='EPSG:4326'\n",
    "        )\n",
    "    \n",
    "    # 2. Download road network\n",
    "    print(f\"\\n[2/7] Downloading road network from OSM...\")\n",
    "    try:\n",
    "        G = ox.graph_from_polygon(perimetro.unary_union, network_type='walk')\n",
    "        print(f\"  ✓ Network obtained: {len(G.nodes())} nodes, {len(G.edges())} edges\")\n",
    "    except Exception as e:\n",
    "        print(f\"  ✗ Error downloading network: {e}\")\n",
    "        return None\n",
    "    \n",
    "    for u, v, key, data in G.edges(keys=True, data=True):\n",
    "        if 'length' not in data:\n",
    "            G[u][v][key]['length'] = 100\n",
    "    \n",
    "    coords_map = {node: (data['x'], data['y']) for node, data in G.nodes(data=True)}\n",
    "    \n",
    "    # 3. Define modes and locate origin\n",
    "    print(f\"\\n[3/7] Defining transport modes...\")\n",
    "    modes = define_transport_modes()\n",
    "    \n",
    "    try:\n",
    "        origin_node = ox.nearest_nodes(G, center_lon, center_lat)\n",
    "        origin_coords = coords_map[origin_node]\n",
    "        print(f\"  ✓ Origin node: {origin_node}\")\n",
    "    except Exception as e:\n",
    "        print(f\"  ✗ Error locating origin: {e}\")\n",
    "        return None\n",
    "    \n",
    "    for mode_name, mode in modes.items():\n",
    "        print(f\"    - {mode_name}: {mode.speed_kmh} km/h, final walk: {mode.final_walk_min} min ({mode.final_walk_distance_m:.0f}m)\")\n",
    "    \n",
    "    # 4. Calculate isochrones\n",
    "    print(f\"\\n[4/7] Calculating isochrones (T={total_budget_min}min)...\")\n",
    "    isochrones = {}\n",
    "    \n",
    "    for mode_name, mode in modes.items():\n",
    "        print(f\"\\n  Processing: {mode_name}...\")\n",
    "        \n",
    "        G_filtered = get_filtered_network(G, mode)\n",
    "        print(f\"    Filtered network: {len(G_filtered.nodes())} nodes, {len(G_filtered.edges())} edges\")\n",
    "        \n",
    "        try:\n",
    "            if origin_node not in G_filtered.nodes():\n",
    "                origin_node_filtered = ox.nearest_nodes(G_filtered, center_lon, center_lat)\n",
    "            else:\n",
    "                origin_node_filtered = origin_node\n",
    "        except Exception as e:\n",
    "            print(f\"    ✗ Error locating node: {e}\")\n",
    "            continue\n",
    "        \n",
    "        reachable_nodes = calculate_isochrone(\n",
    "            G_filtered, origin_node_filtered, mode, total_budget_min=total_budget_min\n",
    "        )\n",
    "        \n",
    "        print(f\"    Reachable nodes: {len(reachable_nodes)}\")\n",
    "        \n",
    "        # Criar polígono de área COM buffer de caminhada final\n",
    "        polygon = create_isochrone_polygon_with_final_walk(\n",
    "            G_filtered, reachable_nodes, coords_map, mode, base_buffer_meters=base_buffer_meters\n",
    "        )\n",
    "        \n",
    "        # Criar GeoDataFrame das arestas alcançáveis\n",
    "        edges_gdf = get_reachable_edges_gdf(G_filtered, reachable_nodes, coords_map)\n",
    "        \n",
    "        polygon_final = None\n",
    "        if polygon is not None and polygon.is_valid:\n",
    "            try:\n",
    "                polygon_clipped = polygon.intersection(perimetro.unary_union)\n",
    "                if polygon_clipped.is_valid and not polygon_clipped.is_empty:\n",
    "                    polygon_final = polygon_clipped\n",
    "                    total_buffer = base_buffer_meters + mode.final_walk_distance_m\n",
    "                    print(f\"    ✓ Polygon created (buffer: {base_buffer_meters}m base + {mode.final_walk_distance_m:.0f}m walk = {total_buffer:.0f}m)\")\n",
    "            except Exception as e:\n",
    "                print(f\"    ! Clip failed, using unclipped: {e}\")\n",
    "                polygon_final = polygon\n",
    "        \n",
    "        isochrones[mode_name] = {\n",
    "            'polygon': polygon_final,\n",
    "            'edges_gdf': edges_gdf,\n",
    "            'reachable_nodes': reachable_nodes,\n",
    "            'mode': mode,\n",
    "            'n_nodes': len(reachable_nodes)\n",
    "        }\n",
    "    \n",
    "    # 5. Load land value data\n",
    "    print(f\"\\n[5/7] Loading land value data...\")\n",
    "    df_values = None\n",
    "    try:\n",
    "        df_values = pd.read_csv('/Users/fjcosta/Documents/projects/Tabular/resultados_inferencia/mediana/predicoes_unit_Londrina.csv')\n",
    "        print(f\"  ✓ {len(df_values)} land value points loaded\")\n",
    "    except:\n",
    "        print(f\"  ✗ Land value data not found\")\n",
    "    \n",
    "    # 6. Load land cover data\n",
    "    print(f\"\\n[6/7] Loading land cover data (DINOv2)...\")\n",
    "    df_cobertura = None\n",
    "    try:\n",
    "        df_cobertura = pd.read_csv('/Users/fjcosta/Documents/projects/DINO_LORA/modelos/final_models/inference_results_londrina/inference_results_with_positions_20250609_083252.csv', sep=';')\n",
    "        print(f\"  ✓ {len(df_cobertura)} land cover patches loaded\")\n",
    "    except:\n",
    "        print(f\"  ✗ Land cover data not found\")\n",
    "    \n",
    "    # 7. Create map\n",
    "    print(f\"\\n[7/7] Generating interactive map...\")\n",
    "    \n",
    "    m = folium.Map(\n",
    "        location=[center_lat, center_lon],\n",
    "        zoom_start=12,\n",
    "        tiles='OpenStreetMap'\n",
    "    )\n",
    "    \n",
    "    # LAYER 1: LAND VALUES\n",
    "    if df_values is not None:\n",
    "        print(\"  Adding land value layer...\")\n",
    "        \n",
    "        pal14 = tim_colors(1000)\n",
    "        min_log_price = df_values['price_predicted'].min()\n",
    "        max_log_price = df_values['price_predicted'].max()\n",
    "        price_range = max_log_price - min_log_price\n",
    "        \n",
    "        grid_spacing = 109.45\n",
    "        half_spacing = grid_spacing / 2\n",
    "        transformer = Transformer.from_crs(\"EPSG:32722\", \"EPSG:4326\", always_xy=True)\n",
    "        \n",
    "        def create_square_utm(utm_x, utm_y, half_size):\n",
    "            return Polygon([\n",
    "                (utm_x - half_size, utm_y - half_size),\n",
    "                (utm_x + half_size, utm_y - half_size),\n",
    "                (utm_x + half_size, utm_y + half_size),\n",
    "                (utm_x - half_size, utm_y + half_size),\n",
    "                (utm_x - half_size, utm_y - half_size)\n",
    "            ])\n",
    "        \n",
    "        def transform_polygon_to_latlon(polygon_utm):\n",
    "            coords_utm = list(polygon_utm.exterior.coords)\n",
    "            coords_latlon = []\n",
    "            for x_utm, y_utm in coords_utm:\n",
    "                lon, lat = transformer.transform(x_utm, y_utm)\n",
    "                coords_latlon.append([lat, lon])\n",
    "            return coords_latlon\n",
    "        \n",
    "        def get_color_from_price(price):\n",
    "            normalized = (price - min_log_price) / price_range if price_range > 0 else 0\n",
    "            color_index = int(normalized * (len(pal14) - 1))\n",
    "            color_index = max(0, min(color_index, len(pal14) - 1))\n",
    "            return pal14[color_index]\n",
    "        \n",
    "        features_valores = []\n",
    "        for idx, row in df_values.iterrows():\n",
    "            square_utm = create_square_utm(row['utm_x'], row['utm_y'], half_spacing)\n",
    "            latlon_polygon = transform_polygon_to_latlon(square_utm)\n",
    "            price = row['price_predicted']\n",
    "            color = get_color_from_price(price)\n",
    "            \n",
    "            geojson_coords = [[[coord[1], coord[0]] for coord in latlon_polygon]]\n",
    "            \n",
    "            feature = {\n",
    "                \"type\": \"Feature\",\n",
    "                \"geometry\": {\n",
    "                    \"type\": \"Polygon\",\n",
    "                    \"coordinates\": geojson_coords\n",
    "                },\n",
    "                \"properties\": {\n",
    "                    \"fillColor\": color,\n",
    "                    \"color\": color,\n",
    "                    \"weight\": 0,\n",
    "                    \"fillOpacity\": 0.7,\n",
    "                    \"popup\": f\"R$ {np.exp(price):,.0f}/m²\"\n",
    "                }\n",
    "            }\n",
    "            features_valores.append(feature)\n",
    "        \n",
    "        geojson_valores = {\n",
    "            \"type\": \"FeatureCollection\",\n",
    "            \"features\": features_valores\n",
    "        }\n",
    "        \n",
    "        folium.GeoJson(\n",
    "            geojson_valores,\n",
    "            style_function=lambda feature: {\n",
    "                'fillColor': feature['properties']['fillColor'],\n",
    "                'color': feature['properties']['color'],\n",
    "                'weight': feature['properties']['weight'],\n",
    "                'fillOpacity': feature['properties']['fillOpacity'],\n",
    "                'opacity': 0\n",
    "            },\n",
    "            tooltip=folium.GeoJsonTooltip(\n",
    "                fields=['popup'],\n",
    "                aliases=['Value:'],\n",
    "                labels=False\n",
    "            ),\n",
    "            name='Land Values'\n",
    "        ).add_to(m)\n",
    "    \n",
    "    # LAYER 2: LAND COVER (DINOv2)\n",
    "    if df_cobertura is not None:\n",
    "        print(\"  Adding land cover layer...\")\n",
    "        \n",
    "        features_cobertura = []\n",
    "        for idx, row in df_cobertura.iterrows():\n",
    "            polygon_coords = create_patch_polygon(row)\n",
    "            predicted_class = row['predicted_class']\n",
    "            color = class_colors.get(predicted_class, '#808080')\n",
    "            confidence = row['prediction_confidence']\n",
    "            \n",
    "            geojson_coords = [[[coord[1], coord[0]] for coord in polygon_coords]]\n",
    "            \n",
    "            feature = {\n",
    "                \"type\": \"Feature\",\n",
    "                \"geometry\": {\n",
    "                    \"type\": \"Polygon\",\n",
    "                    \"coordinates\": geojson_coords\n",
    "                },\n",
    "                \"properties\": {\n",
    "                    \"fillColor\": color,\n",
    "                    \"color\": color,\n",
    "                    \"weight\": 0,\n",
    "                    \"fillOpacity\": 0.6,\n",
    "                    \"class\": predicted_class,\n",
    "                    \"confidence\": f\"{confidence:.2%}\",\n",
    "                    \"popup\": f\"{class_labels.get(predicted_class, predicted_class)} ({confidence:.2%})\"\n",
    "                }\n",
    "            }\n",
    "            features_cobertura.append(feature)\n",
    "        \n",
    "        geojson_cobertura = {\n",
    "            \"type\": \"FeatureCollection\",\n",
    "            \"features\": features_cobertura\n",
    "        }\n",
    "        \n",
    "        folium.GeoJson(\n",
    "            geojson_cobertura,\n",
    "            style_function=lambda feature: {\n",
    "                'fillColor': feature['properties']['fillColor'],\n",
    "                'color': feature['properties']['color'],\n",
    "                'weight': feature['properties']['weight'],\n",
    "                'fillOpacity': feature['properties']['fillOpacity']\n",
    "            },\n",
    "            tooltip=folium.GeoJsonTooltip(\n",
    "                fields=['popup'],\n",
    "                aliases=['Cover:'],\n",
    "                labels=False\n",
    "            ),\n",
    "            name='Land Cover'\n",
    "        ).add_to(m)\n",
    "    \n",
    "    # LAYER 3: ROAD INFRASTRUCTURE (base)\n",
    "    print(\"  Adding road infrastructure layer...\")\n",
    "    \n",
    "    highway_styles = {\n",
    "        'motorway': {'color': '#4B0082', 'weight': 3.5, 'opacity': 0.9},\n",
    "        'trunk': {'color': '#6A0DAD', 'weight': 3, 'opacity': 0.9},\n",
    "        'primary': {'color': '#8B008B', 'weight': 2.5, 'opacity': 0.9},\n",
    "        'secondary': {'color': '#9932CC', 'weight': 2, 'opacity': 0.9},\n",
    "        'tertiary': {'color': '#BA55D3', 'weight': 1.5, 'opacity': 0.9},\n",
    "        'residential': {'color': '#DDA0DD', 'weight': 0.5, 'opacity': 0.9},\n",
    "        'unclassified': {'color': '#E6E6FA', 'weight': 0.4, 'opacity': 0.8},\n",
    "        'living_street': {'color': '#F5DEB3', 'weight': 0.3, 'opacity': 0.7},\n",
    "    }\n",
    "    \n",
    "    edges_gdf_all = ox.graph_to_gdfs(G, nodes=False, edges=True)\n",
    "    \n",
    "    for highway_type, style in highway_styles.items():\n",
    "        subset = edges_gdf_all[edges_gdf_all['highway'] == highway_type]\n",
    "        \n",
    "        if len(subset) > 0:\n",
    "            folium.GeoJson(\n",
    "                subset.__geo_interface__,\n",
    "                style_function=lambda x, s=style: {\n",
    "                    'color': s['color'],\n",
    "                    'weight': s['weight'],\n",
    "                    'opacity': s['opacity']\n",
    "                },\n",
    "                name=f\"{highway_type.capitalize()}\"\n",
    "            ).add_to(m)\n",
    "    \n",
    "    # LAYER 4: ISOCHRONES - AREA (polígonos)\n",
    "    print(\"  Adding isochrone AREA layers...\")\n",
    "    \n",
    "    for mode_name, iso_data in isochrones.items():\n",
    "        polygon = iso_data['polygon']\n",
    "        mode = iso_data['mode']\n",
    "        \n",
    "        if polygon is not None:\n",
    "            try:\n",
    "                geojson_data = polygon.__geo_interface__\n",
    "                \n",
    "                folium.GeoJson(\n",
    "                    geojson_data,\n",
    "                    style_function=lambda x, c=mode.color: {\n",
    "                        'fillColor': c,\n",
    "                        'color': c,\n",
    "                        'weight': 2,\n",
    "                        'fillOpacity': 0.25,\n",
    "                        'opacity': 0.8\n",
    "                    },\n",
    "                    name=f\"{mode_name.capitalize()} Area ({int(total_budget_min)}min)\"\n",
    "                ).add_to(m)\n",
    "                print(f\"    ✓ Added {mode_name} area\")\n",
    "            except Exception as e:\n",
    "                print(f\"    ✗ Failed to add {mode_name} area: {e}\")\n",
    "    \n",
    "    # LAYER 5: ISOCHRONES - NETWORK (linhas)\n",
    "    print(\"  Adding isochrone NETWORK layers...\")\n",
    "    \n",
    "    for mode_name, iso_data in isochrones.items():\n",
    "        edges_gdf = iso_data['edges_gdf']\n",
    "        mode = iso_data['mode']\n",
    "        \n",
    "        if edges_gdf is not None and len(edges_gdf) > 0:\n",
    "            try:\n",
    "                folium.GeoJson(\n",
    "                    edges_gdf.__geo_interface__,\n",
    "                    style_function=lambda x, c=mode.color: {\n",
    "                        'color': c,\n",
    "                        'weight': 2,\n",
    "                        'opacity': 0.8\n",
    "                    },\n",
    "                    name=f\"{mode_name.capitalize()} Network ({int(total_budget_min)}min)\"\n",
    "                ).add_to(m)\n",
    "                print(f\"    ✓ Added {mode_name} network\")\n",
    "            except Exception as e:\n",
    "                print(f\"    ✗ Failed to add {mode_name} network: {e}\")\n",
    "    \n",
    "    # CENTER POINT\n",
    "    folium.CircleMarker(\n",
    "        location=[center_lat, center_lon],\n",
    "        radius=10,\n",
    "        popup=f\"CBD ({city_name})\",\n",
    "        color='black',\n",
    "        fill=True,\n",
    "        fillColor='yellow',\n",
    "        fillOpacity=0.95,\n",
    "        weight=2,\n",
    "        name='CBD'\n",
    "    ).add_to(m)\n",
    "    \n",
    "    # URBAN PERIMETER\n",
    "    folium.GeoJson(\n",
    "        perimetro.__geo_interface__,\n",
    "        style_function=lambda x: {\n",
    "            'fillColor': 'none',\n",
    "            'color': '#333333',\n",
    "            'weight': 2,\n",
    "            'fillOpacity': 0,\n",
    "            'opacity': 0.7\n",
    "        },\n",
    "        name='Urban Perimeter'\n",
    "    ).add_to(m)\n",
    "    \n",
    "    # Layer control\n",
    "    folium.LayerControl(position='topright', collapsed=False).add_to(m)\n",
    "    \n",
    "    # ===== LEFT LEGEND: LAND VALUES =====\n",
    "    legend_valores_html = \"\"\"\n",
    "    <div style=\"position: fixed; top: 10px; left: 10px; width: 280px; height: auto;\n",
    "                background-color: white; border: 2px solid #333; border-radius: 8px; \n",
    "                z-index: 9999; font-size: 9px; padding: 12px; font-family: monospace;\n",
    "                box-shadow: 0 0 10px rgba(0,0,0,0.3);\">\n",
    "    \n",
    "    <h4 style=\"margin: 0 0 10px 0; text-align: center; font-size: 11px; color: #333; \n",
    "               border-bottom: 2px solid #333; padding-bottom: 8px;\">\n",
    "        Median Urban Land Values-2024 (R$/m²)\n",
    "    </h4>\n",
    "    \n",
    "    <table style=\"width: 100%; font-size: 8px; border-collapse: collapse;\">\n",
    "    \"\"\"\n",
    "    \n",
    "    if df_values is not None:\n",
    "        pal14 = tim_colors(1000)\n",
    "        breaks = np.linspace(min_log_price, max_log_price, 10)\n",
    "        real_prices = np.exp(breaks)\n",
    "        \n",
    "        for i in range(len(breaks)-1):\n",
    "            color = pal14[int((i / (len(breaks)-2)) * (len(pal14)-1))]\n",
    "            price_min = real_prices[i]\n",
    "            price_max = real_prices[i+1]\n",
    "            \n",
    "            legend_valores_html += f\"\"\"\n",
    "            <tr style=\"border-bottom: 1px solid #ddd;\">\n",
    "                <td style=\"width: 20px; height: 10px; background-color: {color}; \n",
    "                           border: 1px solid #999;\"></td>\n",
    "                <td style=\"padding-left: 8px; font-size: 8px;\">R$ {price_min:,.0f} - {price_max:,.0f}</td>\n",
    "            </tr>\n",
    "            \"\"\"\n",
    "    \n",
    "    legend_valores_html += \"\"\"\n",
    "    </table>\n",
    "    </div>\n",
    "    \"\"\"\n",
    "    \n",
    "    m.get_root().html.add_child(folium.Element(legend_valores_html))\n",
    "    \n",
    "    # ===== LEFT LEGEND: LAND COVER CLASSES =====\n",
    "    legend_classes_html = \"\"\"\n",
    "    <div style=\"position: fixed; top: 320px; left: 10px; width: 280px; height: auto;\n",
    "                background-color: white; border: 2px solid #333; border-radius: 8px; \n",
    "                z-index: 9999; font-size: 9px; padding: 12px; font-family: monospace;\n",
    "                box-shadow: 0 0 10px rgba(0,0,0,0.3);\">\n",
    "    \n",
    "    <h4 style=\"margin: 0 0 10px 0; text-align: center; font-size: 11px; color: #333;\n",
    "               border-bottom: 2px solid #333; padding-bottom: 8px;\">\n",
    "        Urban Land Cover Classes-2024\n",
    "    </h4>\n",
    "    \n",
    "    <table style=\"width: 100%; font-size: 8px; border-collapse: collapse;\">\n",
    "    \"\"\"\n",
    "    \n",
    "    for class_key in ['hduf', 'mduf', 'lduf', 'industrial', 'bare', 'grass', 'bush', 'tree', 'water', 'crop']:\n",
    "        color = class_colors[class_key]\n",
    "        class_label = class_labels[class_key]\n",
    "        legend_classes_html += f\"\"\"\n",
    "        <tr style=\"border-bottom: 1px solid #ddd;\">\n",
    "            <td style=\"width: 20px; height: 12px; background-color: {color}; \n",
    "                       border: 1px solid #999;\"></td>\n",
    "            <td style=\"padding-left: 8px;\"><b>{class_label}</b></td>\n",
    "        </tr>\n",
    "        \"\"\"\n",
    "    \n",
    "    legend_classes_html += \"\"\"\n",
    "    </table>\n",
    "    </div>\n",
    "    \"\"\"\n",
    "    \n",
    "    m.get_root().html.add_child(folium.Element(legend_classes_html))\n",
    "    \n",
    "    # ===== RIGHT LEGEND: ISOCHRONES + INFRASTRUCTURE =====\n",
    "    legend_html = f\"\"\"\n",
    "    <div style=\"position: fixed; bottom: 50px; right: 10px; width: 320px; height: auto;\n",
    "                background-color: white; border: 2px solid #333; border-radius: 8px; \n",
    "                z-index: 9999; font-size: 10px; padding: 15px; font-family: monospace;\n",
    "                box-shadow: 0 0 15px rgba(0,0,0,0.3); max-height: 70vh; overflow-y: auto;\">\n",
    "    \n",
    "    <h4 style=\"margin: 0 0 12px 0; text-align: center; font-size: 12px; color: #333; \n",
    "               border-bottom: 2px solid #333; padding-bottom: 8px;\">\n",
    "        Multimodal Urban Commute Reachability Analysis - {city_name}\n",
    "    </h4>\n",
    "    \n",
    "    <p style=\"margin: 8px 0; font-size: 9px; color: #666;\">\n",
    "        <b>Travel Time Budget:</b> {int(total_budget_min)} minutes\n",
    "    </p>\n",
    "    \n",
    "    <hr style=\"margin: 8px 0; border: none; border-top: 1px solid #ddd;\">\n",
    "    \n",
    "    <p style=\"margin: 5px 0; font-size: 9px; font-weight: bold; color: #333;\">Transport Modes:</p>\n",
    "    <table style=\"width: 100%; font-size: 9px; border-collapse: collapse;\">\n",
    "    \"\"\"\n",
    "    \n",
    "    for mode_name, iso_data in isochrones.items():\n",
    "        mode = iso_data['mode']\n",
    "        legend_html += f\"\"\"\n",
    "        <tr style=\"border-bottom: 1px solid #eee;\">\n",
    "            <td style=\"width: 14px; height: 12px; background-color: {mode.color}; \n",
    "                       opacity: 0.7; border: 1px solid {mode.color};\"></td>\n",
    "            <td style=\"padding-left: 8px;\"><b>{mode_name.capitalize()}</b> ({int(total_budget_min)} min)</td>\n",
    "        </tr>\n",
    "        \"\"\"\n",
    "    \n",
    "    legend_html += f\"\"\"\n",
    "    </table>\n",
    "    \n",
    "    <hr style=\"margin: 8px 0; border: none; border-top: 1px solid #ddd;\">\n",
    "    \n",
    "    <p style=\"margin: 5px 0; font-size: 9px; font-weight: bold; color: #333;\">Transport Infrastructure:</p>\n",
    "    <table style=\"width: 100%; font-size: 8px;\">\n",
    "    \"\"\"\n",
    "    \n",
    "    for hw_type, style in highway_styles.items():\n",
    "        legend_html += f\"\"\"\n",
    "        <tr style=\"border-bottom: 1px solid #eee;\">\n",
    "            <td style=\"width: 30px; height: 2px; background-color: {style['color']}; \n",
    "                       border: 1px solid {style['color']};\"></td>\n",
    "            <td style=\"padding-left: 8px;\"><b>{hw_type.capitalize()}</b></td>\n",
    "        </tr>\n",
    "        \"\"\"\n",
    "    \n",
    "    legend_html += \"\"\"\n",
    "    </table>\n",
    "    \n",
    "    <hr style=\"margin: 8px 0; border: none; border-top: 1px solid #ddd;\">\n",
    "    \n",
    "    <div style=\"font-size: 8px; color: #666; line-height: 1.4;\">\n",
    "        <b>Methodological notes:</b><br/>\n",
    "        <br/>\n",
    "        <b>Walking:</b> 5 km/h, no overhead time<br/>\n",
    "        <b>Cycling:</b> 16 km/h, 2+2 min walk (167m buffer)<br/>\n",
    "        <b>Bus:</b> 20 km/h, 5+10+5 min overhead (417m buffer)<br/>\n",
    "        <b>Car:</b> 35 km/h, 2+2 min walk (167m buffer)<br/>\n",
    "        <br/>\n",
    "        <b>Road network filters:</b><br/>\n",
    "        • Walking/Cycling: all road types (incl. living_street)<br/>\n",
    "        • Car: all road types (except living_street)<br/>\n",
    "        • Bus: primary roads only (primary, secondary, tertiary, trunk)<br/>\n",
    "        <br/>\n",
    "        <b>Layer types:</b><br/>\n",
    "        • Network: reachable road segments<br/>\n",
    "        • Area: network + final walk buffer<br/>\n",
    "        <br/>\n",
    "        • Isochrones clipped to urban perimeter<br/>\n",
    "        • Data source: OSM (Base Map and Transport Network Infrastructure)<br/>\n",
    "        • Deep Learning Models: TabPFN (Land Values), DINOv2 (Land Cover)\n",
    "    </div>\n",
    "    \n",
    "    </div>\n",
    "    \"\"\"\n",
    "    \n",
    "    m.get_root().html.add_child(folium.Element(legend_html))\n",
    "    \n",
    "    print(f\"  ✓ Map generated in memory\")\n",
    "    print(f\"\\n{'='*70}\\n\")\n",
    "    \n",
    "    return m\n",
    "\n",
    "# EXECUTE\n",
    "londrina_map = generate_isochrone_map_complete(\n",
    "    city_name=\"Londrina\",\n",
    "    center_lat=-23.3120433,\n",
    "    center_lon=-51.1620788,\n",
    "    total_budget_min=60,\n",
    "    base_buffer_meters=50  # buffer base + final_walk_distance de cada modo\n",
    ")\n",
    "\n",
    "# Save HTML\n",
    "output_path = '/Volumes/ssd_externo/landCoverlandValue/landcover_landvalue/Londrina_Isocronas_60min.html'\n",
    "londrina_map.save(output_path)\n",
    "print(f\"\\n✓ HTML saved at: {output_path}\")"
   ]
  }
 ],
